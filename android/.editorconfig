root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.kt]
max_line_length = off
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.kts]
ktlint_standard_chain-wrapping = disabled
ktlint_standard_function-naming = disabled

# Issue #1857 (tech-debt) — entries de enum minusculas propositais: o Kotlin `.name` delas e usado
# como valor persistido/wire (coluna Room `MedicaoEntity.connectionType`, parse do contrato NDS via
# `DiagnosticStatus.valueOf`, sufixo salvo em `SpeedtestPersistenceCoordinator`). Renomear pra
# UpperCamelCase sem uma migracao dedicada quebraria dado ja gravado em producao e o parsing do NDS
# -- ver .claude/rules/higiene-e-padronizacao-repositorio.md §6. Suprime so esta regra, so nestes
# arquivos (nao o modulo inteiro, nao outras regras). Remover a secao quando a issue #1857 fechar.
[core/diagnostico/src/main/kotlin/io/signallq/app/core/diagnostico/{DiagnosticInput,DiagnosticStatus,EvidenceProvenance,HistoricalDegradationEngine,MetricClassifier,NivelCongestionamento}.kt]
ktlint_standard_enum-entry-name-case = disabled

