    {
      "key": "consumer_diagnostico_nds_live_enabled",
      "module": ":featureDiagnostico",
      "type": "BOOLEAN",
      "defaultValue": true,
      "criticality": "HIGH",
      "owner": "product-signallq",
      "description": "Liga a chamada viva ao NDS (NdsClient.evaluate) como fonte do diagnostico. O app tenta o NDS por padrao e usa o DiagnosticRunner local como fallback quando a chamada falha. Ligada, desliga automaticamente o shadow mode do signallq-diagnostic-worker (consumer_diagnostico_shadow_mode_enabled) para o mesmo install -- sem chamadas triplicadas.",
      "disabledBehavior": "SILENT_NO_OP",
      "disabledMessage": null,
      "dependencies": ["consumer_diagnostico_enabled"],
      "androidImplemented": true,
      "adminManaged": true,
      "analyticsEvent": null
    },
    {
      "key": "consumer_diagnostico_assist_nds_v2_enabled",
      "module": ":featureDiagnostico",
      "type": "BOOLEAN",
      "defaultValue": true,
      "criticality": "MEDIUM",
      "owner": "product-signallq",
      "description": "Liga o uso do contrato POST /v2/diagnostics/evaluate do NDS (contexto opcional, resposta {raw, explanation}) no caminho dedicado do Assist (NdsDiagnosticRepository.evaluateForAssist), no lugar do /v1/diagnostics/evaluate atual. O catalogo local inicia ligado e a rota v2 e usada mesmo com contexto parcial. O endpoint v2 foi publicado pelo NDS na PR #24 e a reversao continua disponivel pelo Firebase Remote Config.",
      "disabledBehavior": "SILENT_NO_OP",
      "disabledMessage": null,
      "dependencies": [],
      "androidImplemented": true,
      "adminManaged": true,
      "analyticsEvent": null
    },
    {
      "key": "consumer_diagnostico_nds_v2_enabled",
      "module": ":featureDiagnostico",
      "type": "BOOLEAN",
      "defaultValue": true,
      "criticality": "MEDIUM",
      "owner": "product-signallq",
      "description": "Liga o uso do contrato POST /v2/diagnostics/evaluate do NDS (mesmo envelope {raw, explanation} ja suportado pelo parser do Assist) no fluxo principal de diagnostico (DiagnosticOrchestrator.executarProtegido -> NdsDiagnosticRepository.evaluate), no lugar do /v1/diagnostics/evaluate atual. So tem efeito quando consumer_diagnostico_nds_live_enabled tambem esta ligada (o NDS precisa ser a fonte ativa para a rota importar). O v2 e estritamente aditivo sobre o v1 (sem risco de schema); default true faz o v2 ser o padrao para todos os usuarios a partir desta versao do app, mantendo a flag como kill-switch de emergencia via Firebase Remote Config (desligar volta para o v1 sem publicar nova versao do app).",
      "disabledBehavior": "SILENT_NO_OP",
      "disabledMessage": null,
      "dependencies": ["consumer_diagnostico_nds_live_enabled"],
      "androidImplemented": true,
      "adminManaged": true,
      "analyticsEvent": null
    },
